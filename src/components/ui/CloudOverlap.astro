---
/**
 * Decorative cloud silhouette from the Figma kit (component "Hero") — a
 * reusable overlap graphic pinned to the bottom edge of a section, used to
 * transition into whatever comes next (hero → about, event → tickets,
 * directions → sponsors). Native art is 1920×546.38, clipped to a 1920×457
 * window per Figma, so the wrapper crops the bottom slice off.
 * Color is set by the caller via a text-* utility (fill: currentColor).
 */
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
