---
import Button from "./Button.astro";
import Logo from "./Logo.astro";

/* Button destinations, from the dev notes on the Figma Nav Bar (660:8893).
   Both buttons appear twice — once in the bar, once in the mobile menu. */
const TICKETS = "https://www.quicket.co.za/events/389341-ceres-kersiefees/#/";
const CONTACT = "mailto:runeik@dutoit.com";

const links: { label: string; href: string; }[] = [
  { label: "Meer oor die fees", href: "#about-section" },
  { label: "Koservaring", href: "#verkopers" },
  { label: "Program", href: "#program" },
  { label: "Sportaktiwiteite", href: "#sport-section" },
  { label: "Akkommodasie", href: "#akkommodasie" },
];
---

<header class="fixed inset-x-0 top-6 z-50 px-8 landscape:top-4 landscape:px-4" data-navbar>
  <div class="mx-auto flex max-w-nav items-center justify-between gap-6 rounded-full bg-white py-4 pl-10 pr-4 shadow-cherry-soft landscape:py-3 landscape:pl-6 landscape:pr-3">
    <a href="#top" class="shrink-0">
      <Logo />
    </a>

    <nav class="flex items-center gap-4 tablet:hidden" aria-label="Hoofnavigasie">
      {links.map((link) => (
        <a
          href={link.href}
          class="whitespace-nowrap rounded-full px-3 py-1.5 text-md text-cherry transition-colors hover:bg-blossom hover:text-cherry-dark"
          data-nav-link>
          {link.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-4 tablet:hidden">
      <Button href={TICKETS} arrow={false}>Kry Kaartjies</Button>
      <Button href={CONTACT} arrow={false}>Kontak</Button>
    </div>

    <button
      type="button"
      class="hidden size-11 items-center justify-center rounded-full bg-cherry text-white tablet:flex"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Maak kieslys oop" data-menu-toggle>
      <svg
        class="size-5" viewBox="0 0 20 20" fill="none" stroke="currentColor"
        stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path class="menu-open-icon" d="M2 5h16M2 10h16M2 15h16" />
        <path class="menu-close-icon hidden" d="M4 4l12 12M16 4L4 16" />
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class="mx-auto mt-2 hidden max-w-nav flex-col gap-1 rounded-3xl bg-white p-6 shadow-cherry not-tablet:hidden!">
    {links.map((link) => (
      <a href={link.href} class="rounded-xl px-4 py-3 text-lg text-cherry transition-colors hover:bg-blossom" data-menu-link data-nav-link>
        {link.label}
      </a>
    ))}
    <div class="mt-3 flex flex-wrap gap-3">
      <Button href={TICKETS} arrow={false}>Kry Kaartjies</Button>
      <Button href={CONTACT} arrow={false}>Kontak</Button>
    </div>
  </div>
</header>

<script>
const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
const menu = document.getElementById("mobile-menu");

const setOpen = (open: boolean) => {
  if (!toggle || !menu) return;
  toggle.setAttribute("aria-expanded", String(open));
  toggle.setAttribute("aria-label", open ? "Maak kieslys toe" : "Maak kieslys oop");
  menu.classList.toggle("hidden", !open);
  menu.classList.toggle("flex", open);
  toggle.querySelector(".menu-open-icon")?.classList.toggle("hidden", open);
  toggle.querySelector(".menu-close-icon")?.classList.toggle("hidden", !open);
};

toggle?.addEventListener("click", () => {
  setOpen(toggle.getAttribute("aria-expanded") !== "true");
});
menu?.querySelectorAll("[data-menu-link]").forEach((link) => {
  link.addEventListener("click", () => setOpen(false));
});

/* ---------------------------------------------------------------------------
   Scroll spy: the pink pill marks the linked section the reader is currently
   in. The test is a single line across the middle of the viewport, so exactly
   one section can ever own it — a band would let two neighbours tie on the
   boundary between them.
--------------------------------------------------------------------------- */
// Each section is linked twice: once from the bar, once from the mobile menu.
const targets = new Map<HTMLElement, HTMLAnchorElement[]>();
document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]").forEach((link) => {
  const section = document.getElementById(link.hash.slice(1));
  if (!section) return;
  const group = targets.get(section);
  if (group) group.push(link);
  else targets.set(section, [link]);
});

const paint = (current: HTMLElement | null) => {
  targets.forEach((links, section) => {
    const on = section === current;
    links.forEach((link) => {
      link.classList.toggle("bg-blossom", on);
      if (on) link.setAttribute("aria-current", "location");
      else link.removeAttribute("aria-current");
    });
  });
};

let queued = false;
const syncSpy = () => {
  queued = false;
  const line = window.innerHeight / 2;
  let current: HTMLElement | null = null;
  for (const section of targets.keys()) {
    const rect = section.getBoundingClientRect();
    if (rect.top <= line && rect.bottom > line) {
      current = section;
      break;
    }
  }
  paint(current);
};

const requestSync = () => {
  if (queued) return;
  queued = true;
  requestAnimationFrame(syncSpy);
};

addEventListener("scroll", requestSync, { passive: true });
addEventListener("resize", requestSync);
syncSpy();
</script>
