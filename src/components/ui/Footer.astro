---
import ellipse from "../../assets/figma/footer-ellipse.svg";
import footerLogo from "../../assets/figma/footer-logo.svg";
import rocket from "../../assets/figma/icon-rocket.svg";
import facebook from "../../assets/figma/social-facebook.svg";
import instagram from "../../assets/figma/social-instagram.svg";
import linkedin from "../../assets/figma/social-linkedin.svg";
import x from "../../assets/figma/social-x.svg";
import Container from "../ui/Container.astro";

const socials = [
  { icon: facebook.src, label: "Facebook" },
  { icon: linkedin.src, label: "LinkedIn" },
  { icon: instagram.src, label: "Instagram" },
  { icon: x.src, label: "X" },
];

const quickLinks = [
  "Bepalings & Voorwaardes",
  "Uitstalleraansoek",
  "Borgnavrae",
  "Privaatheidsbeleid",
  "Mediapakket",
  "Akkommodasievennootskap",
];
---

<footer class="relative overflow-hidden bg-blossom text-white">
  <!-- rolling red hills lead-in -->
  <img src='./images/backgrounds/kersiefees-footer-landscape.svg' alt="" aria-hidden="true" class="relative z-1 -mb-px block w-full max-w-none landscape:w-[290%] landscape:-translate-x-1/4" />

  <div class="relative bg-cherry">
    <img src={ellipse.src} alt="" aria-hidden="true" class="pointer-events-none absolute -top-3.5 left-0 w-full max-w-none" />

    <Container class="relative">
      <!-- newsletter -->
      <div class="grid grid-cols-2 gap-24 tablet:grid-cols-1 tablet:gap-10" data-reveal>
        <div class="flex items-start gap-8 landscape:gap-5">
          <span class="flex size-25 shrink-0 items-center justify-center rounded-tile bg-white/5 landscape:size-20">
            <img src={rocket.src} alt="" class="size-14.5 landscape:size-11" loading="lazy" />
          </span>
          <h2 class="h1 max-w-75" data-split>Teken in op ons Nuusbrief</h2>
        </div>

        <form class="flex h-17.5 w-full max-w-141.25 items-center gap-2 rounded-full bg-white/10 py-2.5 pl-6 pr-3.25" data-newsletter>
          <label class="sr-only" for="newsletter-email">Jou Epos Adres</label>
          <input
            id="newsletter-email" type="email" required placeholder="Jou Epos Adres"
            class="h-full w-full bg-transparent text-base text-white placeholder:text-white/30 outline-none"
          />
          <button
            type="submit"
            aria-label="Teken in"
            class="flex size-12.5 shrink-0 cursor-pointer items-center justify-center rounded-full bg-cherry-dark text-white transition-transform duration-300 hover:rotate-360">
            <svg class="h-3 w-5" viewBox="0 0 19.2474 12.2034" fill="currentColor" aria-hidden="true">
              <path d="M11.801 10.0095C12.9002 9.16004 13.5482 8.54752 15.0758 7.54991C15.0608 7.52291 12.6582 7.61182 12.644 7.61227C10.187 7.68768 9.79572 7.72833 7.33827 7.76621C5.69389 7.79156 3.88339 7.85407 2.39014 7.82587C0.984344 7.79932 0.389669 7.63762 0.124769 7.13294C-0.570293 5.80889 1.83616 5.85794 2.48089 5.80841C3.61328 5.72144 4.74679 5.72291 5.88049 5.67644C7.39313 5.61446 8.90656 5.57242 10.4203 5.55037C10.7792 5.54516 12.8 5.55461 14.2502 5.59173C13.2676 4.61936 12.3567 3.74988 11.9582 3.34117C11.3503 2.71766 10.8515 2.35912 10.3838 1.57976C9.86659 0.717668 11.0817 -0.403956 11.5997 0.145681C12.3635 0.956244 13.1263 1.79729 14.0138 2.59968C15.146 3.62347 16.3668 4.56329 17.7398 5.24287C19.5 6.11414 19.8865 7.28032 17.9955 8.28727C16.5323 9.06648 15.1432 9.98489 13.8531 11.026C13.0602 11.666 12.7064 11.9769 11.9894 12.1639C10.8249 12.4677 10.5865 10.9481 11.801 10.0095Z" />
            </svg>
          </button>
        </form>
      </div>

      <!-- divider sits in its own 64px band, per the frame -->
      <div class="py-16 landscape:py-10">
        <div class="h-px w-full bg-blossom"></div>
      </div>

      <!-- footer content -->
      <div class="grid grid-cols-2 gap-24 tablet:grid-cols-1 tablet:gap-12">
        <div class="flex flex-col gap-8">
          <img src={footerLogo.src} alt="Ceres Kersiefees" class="w-60 landscape:w-45" loading="lazy" />
          <p class="max-w-120 text-lg leading-normal">
            Of jy &rsquo;n kersie-smulpaap is, &rsquo;n sportliefhebber, &rsquo;n Musiekentoesias of net die kersies wil sien dans - daar is iets vir almal by die Ceres
            Kersiefees.
          </p>
          <div class="flex items-center gap-2">
            {socials.map((social) => (
              <a
                href="#"
                aria-label={social.label}
                class="flex size-10 items-center justify-center rounded-full bg-blossom transition-transform hover:scale-110">
                <img src={social.icon} alt="" class="size-6" loading="lazy" />
              </a>
            ))}
          </div>
        </div>

        <div class="flex flex-col gap-2.5">
          <h3 class="text-lg font-bold">Vinnige Skakels</h3>
          <ul class="grid max-w-121 grid-cols-2 gap-6 text-base portrait:grid-cols-1">
            {quickLinks.map((link) => (
              <li>
                <a href="#" class="transition-opacity hover:opacity-80">
                  {link}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </Container>

    <!-- ribbon: 24px band, so it uses the container gutters without its own
         vertical rhythm (Container bakes in the 96px section padding) -->
    <div class="relative bg-white/5 py-6">
      <div class="mx-auto w-full max-w-content px-16 text-right tablet:px-8 portrait:px-5">
        <p class="text-lg text-white landscape:text-base">
          © 2026 Ceres Kersiefees. Alle regte voorbehou.
        </p>
      </div>
    </div>
  </div>
</footer>

<script>
const form = document.querySelector<HTMLFormElement>("[data-newsletter]");
form?.addEventListener("submit", (event) => {
  event.preventDefault();
  const input = form.querySelector("input");
  if (input) {
    input.value = "";
    input.placeholder = "Dankie! Jy is ingeteken. 🍒";
  }
});
</script>
