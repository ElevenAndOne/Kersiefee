---
/**
 * Sport card from the Figma kit: a cherry block with a title, a tight stack
 * of detail lines and a white CTA pill. The card has no width of its own —
 * it fills whichever masonry column it lands in.
 *
 * The sport illustration sits on its own layer (so it can be faded to 30%
 * without touching the copy): full card width, height left to the artwork's
 * aspect ratio, pinned to the bottom edge — a short card therefore shows
 * only the bottom of the drawing.
 */
import type { HTMLAttributes } from "astro/types";
import Button from "./Button.astro";

interface Props extends HTMLAttributes<"article"> {
  title: string;
  /** detail lines; an empty string renders a blank line, as in Figma */
  lines?: string[];
  cta?: string;
  href?: string;
  /** decorative illustration, e.g. "/images/sports/golf.svg" */
  image?: string;
}

const {
  title,
  lines = [],
  cta = "Inskrywings",
  href = "#kontak",
  image,
  class: className = "",
  ...rest
} = Astro.props;

const backdrop = `background-image:url("${image}");background-size:100% auto;background-position:bottom center;background-repeat:no-repeat;`;
---

<article {...rest} class:list={["relative overflow-hidden rounded-blob bg-cherry p-8 text-white portrait:p-6", className]}>
  {image && <div class="pointer-events-none absolute inset-0 opacity-30" style={backdrop} aria-hidden="true"></div>}

  <div class="relative flex flex-col gap-5">
    <h3 class="h2">{title}</h3>
    {lines.length > 0 && (
      <div class="body-lg font-bold leading-tight">
        {lines.map((line) => (line ? <p>{line}</p> : <p aria-hidden="true">&nbsp;</p>))}
      </div>
    )}
    <Button href={href} variant="white" class="self-start">{cta}</Button>
  </div>
</article>
