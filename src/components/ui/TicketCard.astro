---
/**
 * Festival ticket: a wide, slightly tilted panel — title, details and price
 * on the left, a square image on the right. The tilt is an inline transform
 * (GSAP overwrites it on reveal), and the width comes from the caller, since
 * the ticket stack staggers its cards left and right.
 *
 * `flush` is the second Figma layout variant: instead of an inset square
 * photo, the image bleeds to the card's top and bottom edges (used by the
 * red "Kinderkaartjie" card, whose asset is a transparent cutout rather than
 * a cropped photo).
 */
import Button from "./Button.astro";

interface PriceLine {
  label?: string;
  price: string;
}

interface Props {
  title: string;
  lines?: string[];
  prices?: PriceLine[];
  cta?: string;
  href?: string;
  variant?: "red" | "white";
  /** tilt in degrees */
  rotate?: number;
  image?: { src: string; alt: string; } | null;
  /** placeholder block instead of a photo (as in Figma) */
  placeholder?: boolean;
  /** image bleeds to the card's top/bottom edges instead of sitting inset */
  flush?: boolean;
  class?: string;
}

const {
  title,
  lines = [],
  prices = [],
  cta = "Koop Kaartjies Nou!",
  href = "#kaartjies",
  variant = "red",
  rotate = 0,
  image = null,
  placeholder = false,
  flush = false,
  class: className = "",
} = Astro.props;

const isRed = variant === "red";
---

<div class:list={[className]} style={`transform: rotate(${rotate}deg);`} data-ticket>
  <div
    class:list={[
      /* the image keeps Figma's share of the ticket (480 of the 1081px inner
         width), so the split holds as the ticket narrows */
      "ticket-notch grid grid-cols-[minmax(0,1fr)_44%] gap-x-8 landscape:grid-cols-1 landscape:gap-8 landscape:p-8 portrait:p-6",
      /* flush drops the shared padding at desktop width so the image can
         reach the top/bottom edges — the text column carries its own
         padding instead (see below). Horizontal padding stays symmetric
         (px, not pl) so the bleeding image still clears the card's own
         right-edge notches instead of sitting flush against them. */
      flush ? "py-0 px-16 tablet:px-12" : "p-16 tablet:p-12",
      /* the notch class paints the card colour, so pass it as the fill
         rather than a bg-* utility (see .ticket-notch in global.css) */
      isRed ? "text-white [--notch--fill:var(--color-cherry)]" : "text-cherry [--notch--fill:var(--color-white)]",
    ]}>
    <div
      class:list={[
        "flex flex-col items-start gap-15 self-center landscape:gap-8 landscape:pt-5",
        flush && "py-16 tablet:py-12 landscape:py-0",
      ]}>
      <div class="flex max-w-120 flex-col gap-5">
        <h3 class="h1">{title}</h3>
        {lines.map((line) => <p class="h3">{line}</p>)}
        {prices.map((p) => (
          <Fragment>
            {p.label && <p class="h3">{p.label}</p>}
            <p class="h1">{p.price}</p>
          </Fragment>
        ))}
      </div>
      <Button href={href} variant={isRed ? "white" : "red"}>{cta}</Button>
    </div>

    <div class:list={[flush ? "self-stretch landscape:self-start" : "self-start"]}>
      {image ? (
        <img
          src={image.src}
          alt={image.alt}
          loading="lazy"
          class:list={[
            flush
              ? "h-full w-full object-contain object-bottom-right landscape:aspect-square landscape:h-auto landscape:rounded-blob landscape:object-cover landscape:object-center"
              : "aspect-square w-full rounded-blob object-cover",
          ]}
        />
      ) : placeholder ? (
        <div class:list={["aspect-square w-full rounded-blob", isRed ? "bg-black/20" : "bg-[#c4c4c4]"]} />
      ) : null}
    </div>
  </div>
</div>
