---
/**
 * Pill button from the Figma kit.
 *  - variant "red":   cherry pill, white label, white circle + red arrow
 *  - variant "white": white pill, cherry label, cherry circle + white arrow
 *  - arrow can be hidden for plain pills (nav buttons)
 */
interface Props {
  href?: string;
  variant?: "red" | "white";
  arrow?: boolean;
  class?: string;
  type?: "button" | "submit";
  /** Set on off-site links; `rel` defaults to a safe noopener pair. */
  target?: "_blank";
  rel?: string;
}

const {
  href,
  variant = "red",
  arrow = true,
  class: className = "",
  type = "button",
  target,
  rel = target === "_blank" ? "noopener noreferrer" : undefined,
} = Astro.props;

const base =
  "h-14 w-fit group inline-flex items-center gap-4 rounded-full font-extrabold text-button leading-none transition-transform duration-200 cursor-pointer select-none";
const look = variant === "red" ? "bg-cherry text-white" : "bg-white text-cherry";
const pad = arrow ? "pl-7 pr-2 py-1.5" : "px-4 py-1.5";
const circle = variant === "red" ? "bg-white text-cherry" : "bg-cherry text-white";

const Tag = href ? "a" : "button";
---

<Tag
  href={href} type={href ? undefined : type} target={href ? target : undefined} rel={href ? rel : undefined}
  class:list={[base, look, pad, className]}>
  <span class="py-1.5 whitespace-nowrap landscape:whitespace-normal landscape:leading-snug"><slot /></span>
  {arrow && (
    <span class:list={["flex size-11 shrink-0 items-center justify-center rounded-full transition-transform duration-300 group-hover:rotate-360", circle]}>
      <svg class="h-3 w-5" viewBox="0 0 19.2474 12.2034" fill="currentColor" aria-hidden="true">
        <path d="M11.801 10.0095C12.9002 9.16004 13.5482 8.54752 15.0758 7.54991C15.0608 7.52291 12.6582 7.61182 12.644 7.61227C10.187 7.68768 9.79572 7.72833 7.33827 7.76621C5.69389 7.79156 3.88339 7.85407 2.39014 7.82587C0.984344 7.79932 0.389669 7.63762 0.124769 7.13294C-0.570293 5.80889 1.83616 5.85794 2.48089 5.80841C3.61328 5.72144 4.74679 5.72291 5.88049 5.67644C7.39313 5.61446 8.90656 5.57242 10.4203 5.55037C10.7792 5.54516 12.8 5.55461 14.2502 5.59173C13.2676 4.61936 12.3567 3.74988 11.9582 3.34117C11.3503 2.71766 10.8515 2.35912 10.3838 1.57976C9.86659 0.717668 11.0817 -0.403956 11.5997 0.145681C12.3635 0.956244 13.1263 1.79729 14.0138 2.59968C15.146 3.62347 16.3668 4.56329 17.7398 5.24287C19.5 6.11414 19.8865 7.28032 17.9955 8.28727C16.5323 9.06648 15.1432 9.98489 13.8531 11.026C13.0602 11.666 12.7064 11.9769 11.9894 12.1639C10.8249 12.4677 10.5865 10.9481 11.801 10.0095Z" />
      </svg>
    </span>
  )}
</Tag>
