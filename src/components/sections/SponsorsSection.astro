---
import Button from "../ui/Button.astro";
import Container from "../ui/Container.astro";
import Section from "../ui/Section.astro";

/* Partner logos exported from Figma, in the Logo Carousel List order (logo/09 -> logo/01);
   logo/07 does not appear in the Sponsors Section design and is intentionally omitted.
   logo/01 (sponsor-5.svg, Witzenberg Munisipaliteit) was pulled at the client's
   request; the asset stays in the repo in case it goes back up. */
import logo09 from "../../assets/figma/sponsor-1.svg";
import logo04 from "../../assets/figma/sponsor-3.svg";
import logo08 from "../../assets/figma/sponsor-4.svg";
import logo06 from "../../assets/figma/sponsor-6.svg";
import logo05 from "../../assets/figma/sponsor-7.svg";
import logo03 from "../../assets/figma/sponsor-8.svg";
import logo02 from "../../assets/figma/sponsor-9.svg";

/* Kept as full metadata: the width/height attributes below let the browser
   size each logo's box before the lazy SVG downloads, so the marquee track
   measures at its real width from the first frame. */
const logos = [logo09, logo08, logo06, logo05, logo04, logo03, logo02];
---

<Section id="sponsors-section" bg="white">
  <Container>
    <div class="grid grid-cols-2 gap-16 tablet:grid-cols-1">
      <div class="flex flex-col gap-6">
        <h2 class="h1" data-split>Dankie aan ons borge!</h2>
        <p class="h3 mt-4">Ceres Kersiefees 2026 word moontlik gemaak deur die vrygewige ondersteuning van ons borge.</p>
      </div>
      <div class="flex flex-col items-end">
        <Button href="mailto:runeik@dutoit.com" class="shrink-0">Stel belang om te borg? Kontak ons</Button>
      </div>
    </div>

    <div class="flex flex-col items-center mt-24" data-marquee data-marquee-speed="40">
      <div class="w-screen">
        <div class="marquee-track gap-28 pr-28 landscape:gap-16 landscape:pr-16">
          {[0, 1].map((copy) => (
            <div class="flex shrink-0 items-center gap-28 landscape:gap-16" aria-hidden={copy === 1 ? "true" : undefined}>
              {logos.map((logo, i) => (
                <img
                  src={logo.src}
                  width={logo.width}
                  height={logo.height}
                  alt={copy === 0 ? `Borg-logo ${i + 1}` : ""}
                  class="h-33.75 w-auto object-contain landscape:h-16"
                  loading="lazy"
                />
              ))}
            </div>
          ))}
        </div>
      </div>
    </div>
  </Container>
</Section>
