---

<Section id="sport-section" bg="none" class="z-10">
  <Container class="flex flex-col gap-24 landscape:gap-12">
    <h2 class="h1 text-center" data-split>
      Neem deel aan Ceres Kersiefees Sport!
    </h2>

    {
      /* Auto-scrolling carousel, same full-bleed marquee mechanic as the
        About/Sponsors/Kersie-Jol tickers (w-screen breakout, clipped by
        Section's overflow-hidden). It gets its own data attribute rather
        than `data-marquee` because the shared marquees() helper only eases
        speed down to 15% on hover -- this carousel needs a genuine stop, so
        it runs its own tween below instead of being picked up by that
        helper. */
    }
    <div class="flex flex-col" data-sports-marquee data-marquee-speed="40">
      <div class="w-screen">
        <div class="marquee-track gap-5 pr-5 items-start! min-h-120">
          {
            [0, 1].map((copy) => (
              <div class="flex shrink-0 items-start gap-5" aria-hidden={copy === 1 || undefined} >
                {sports.map((sport) => (
                  <SportCard
                    {...sport}
                    class="w-[clamp(17rem,32vw,25rem)] shrink-0"
                    data-rise
                  />
                ))}
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </Container>
</Section>

<script>
  import { gsap } from "gsap";
  import { dragScrub } from "../../scripts/marquee";
  import { reducedMotion, registerEases } from "../../scripts/motion";

  registerEases();

  const wrap = document.querySelector<HTMLElement>("[data-sports-marquee]");
  const track = wrap?.querySelector<HTMLElement>(".marquee-track");

  if (wrap && track) {
    if (reducedMotion()) {
      /* No auto-scroll: drop the aria-hidden/inert duplicate group (it only
         exists to make the loop seamless) and let the track become a plain
         manually-scrollable strip instead. Scoped to a direct child of the
         track -- cards further down also carry aria-hidden on decorative
         bits (backdrops, blank spacer lines), which must stay put. */
      track.parentElement?.classList.add("overflow-x-auto");
      track
        .querySelectorAll<HTMLElement>(':scope > [aria-hidden="true"]')
        .forEach((el) => el.remove());
    } else {
      /* The duplicate group stays aria-hidden for screen readers, but it must
         stay fully hoverable and clickable -- it's half of what's on screen
         at any moment, so its cards need to expand on hover exactly like the
         first set (an earlier pass used `inert` here, which also blocks
         hit-testing and silently killed hover for the whole group). The only
         thing still worth trimming is sequential Tab order, so its CTA
         links don't duplicate stops for keyboard users -- tabindex="-1" does
         that without touching mouse/hover at all. */
      track
        .querySelectorAll<HTMLElement>(
          ':scope > [aria-hidden="true"] a, :scope > [aria-hidden="true"] button',
        )
        .forEach((el) => {
          el.tabIndex = -1;
        });

      const speed = Number(wrap.dataset.marqueeSpeed ?? 40); // px / second
      /* One loop period: the offset between the two identical copies. NOT
         scrollWidth / 2 — once the track overflows, Chrome leaves its
         trailing padding-right out of scrollWidth, which put the wrap point
         half that padding short of a full period: a small jump every loop. */
      const copies = track.querySelectorAll<HTMLElement>(":scope > *");
      const distance = copies[1].offsetLeft - copies[0].offsetLeft;
      const tween = gsap.to(track, {
        x: -distance,
        duration: distance / speed,
        ease: "none",
        repeat: -1,
      });

      /* Inertial hover: ramps timeScale all the way to 0 (the shared
         marquees() helper only eases down to 15%) so the carousel genuinely
         comes to rest, then eases back up from wherever it stopped -- no
         snap, no restart, it just keeps reading where it left off. */
      const rampTo = (scale: number, duration: number, ease: string) =>
        gsap.to(tween, { timeScale: scale, duration, ease, overwrite: true });

      const slowToStop = () => rampTo(0, 0.7, "power2.out");
      const speedBackUp = () => rampTo(1, 0.9, "power1.inOut");

      /* Tracked so releasing a drag while still hovering leaves the carousel
         at rest, rather than overriding the hover stop. */
      let hovering = false;
      wrap.addEventListener("mouseenter", () => {
        hovering = true;
        slowToStop();
      });
      wrap.addEventListener("mouseleave", () => {
        hovering = false;
        speedBackUp();
      });

      // Keyboard focus (tabbing to a card's CTA) pauses it the same way --
      // otherwise a moving target is nearly impossible to use without a mouse.
      wrap.addEventListener("focusin", slowToStop);
      wrap.addEventListener("focusout", (event) => {
        const next = (event as FocusEvent).relatedTarget as Node | null;
        if (!next || !wrap.contains(next)) speedBackUp();
      });

      /* Drag to scrub. Hover already brings this row to a stop, so a drag on
         desktop is really about throwing it further than the wait allows;
         on touch, where there is no hover, it is the only way to steer it. */
      dragScrub(wrap, tween, {
        span: -distance,
        onGrab: () => gsap.killTweensOf(tween),
        onRelease: () => {
          if (!hovering) speedBackUp();
        },
      });
    }
  }
</script>
