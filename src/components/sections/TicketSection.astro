---
import type { ComponentProps } from "astro/types";
import Container from "../ui/Container.astro";
import Section from "../ui/Section.astro";
import TicketCard from "../ui/TicketCard.astro";

import bgVector from "../../assets/figma/ticket-bg-vector.svg";
import cherryTimePhoto from "../../assets/figma/ticket-photo-cherry-time.avif";
import fynbosVelddagPhoto from "../../assets/figma/ticket-photo-fynbos-velddag.avif";
import kersieLangtafelPhoto from "../../assets/figma/ticket-photo-kersie-langtafel.avif";
import kersiekreatiefPhoto from "../../assets/figma/ticket-photo-kersiekreatief.avif";
import kinderkaartjiePhoto from "../../assets/figma/ticket-photo-kinderkaartjie.avif";
import opelugPreekPhoto from "../../assets/figma/ticket-photo-opelug-preek.avif";
import standaardkaartjiePhoto from "../../assets/figma/ticket-photo-standaardkaartjie.avif";

const quicketHref = "https://www.quicket.co.za/events/389341-ceres-kersiefees/#/";


/* `hidden` keeps a ticket in the file but off the page. Kersiekreatief, Kersie
   Langtafel and Fynbos Velddag are hidden at the client's request ("Please HIDE
   for now"), so restoring one is a single flag once its details firm up. */
const tickets: (ComponentProps<typeof TicketCard> & { hidden?: boolean; })[] = [
  {
    title: "Cherry Time™ Kersieplaas-Besoek",
    lines: [
      "Stap tussen die kersiebome, proe die vars kersies, ontmoet die mense agter die oes en ervaar Ceres se kersieseisoen eerstehands! Meer inligting sal volg.",
    ],
    cta: "Leer meer",
    variant: "red",
    image: { src: cherryTimePhoto.src, alt: "'n Hand pluk ryp kersies van 'n tak" },
    href: "tel:+27749685168",
  },
  {
    title: "Kersiekreatief",
    hidden: true,
    lines: [{
      date: "Donderdag, 3 Desember 2026",
      text: "Uitstalling deur kunstenaars in die Ceres omgewing. Meer inligting sal volg.",
    }],
    cta: "Leer meer",
    variant: "white",
    rotate: -2,
    image: { src: kersiekreatiefPhoto.src, alt: "'n Ingeraamde kersie-kunswerk teen 'n galerymuur" },
    href: "tel:+27827515281",
  },
  {
    title: "Kersie Langtafel",
    hidden: true,
    lines: [{
      date: "Vrydag, 4 Desember 2026",
      text: "'n Kersie geinspireerde langtafel ete saam 'n bekroonde smul!",
    }],
    cta: "Leer meer",
    variant: "red",
    image: { src: kersieLangtafelPhoto.src, alt: "Feesgangers kuier om 'n feestelike langtafel in die buitelug" },
    href: "tel:+27781446180",
  },
  {
    title: "Standaardkaartjie",
    lines: ["Saterdag, 5 Desember 2026", "Sluit die toegang in tot die feesgronde vanaf 16:00"],
    prices: [{ price: "R250" }],
    variant: "white",
    rotate: -2,
    image: { src: standaardkaartjiePhoto.src, alt: "Feesganger geniet 'n verkoelende kersiedrankie" },
    href: quicketHref,
  },
  {
    title: "Kinderkaartjie",
    lines: ["(5-18 ouderdom)", "Sluit die toegang in tot die feesgronde vanaf 16:00"],
    prices: [{ price: "R150" }],
    variant: "red",
    rotate: -0.36,
    flush: true,
    image: { src: kinderkaartjiePhoto.src, alt: "Riaan Benadé en Bok van Blerk tree op by die Kersiefees" },
    href: quicketHref,
  },
  {
    title: "Opelug Preek",
    lines: [{
      date: "Sondag, 6 Desember 2026",
      text:
        "Kerke, bedieninge en gelowiges van Ceres en omgewing word uitgenooi om saam te kom vir 'n spesiale oggend van lofprysing en aanbidding ter ere van Jesus.",
    }],
    prices: [{ price: "Gratis" }],
    cta: "Leer meer",
    variant: "white",
    rotate: -2,
    image: { src: opelugPreekPhoto.src, alt: "Feesgangers aanbid saam terwyl die son sak" },
    href: "tel:+27749685168",
  },
  {
    title: "Fynbos Velddag",
    hidden: true,
    lines: ["Geinspireerde fynbos gesprek saam met Leon Kluge! Meer inligting sal volg."],
    cta: "Leer meer",
    variant: "red",
    image: { src: fynbosVelddagPhoto.src, alt: "'n Voël rus op fynbos" },
    href: "tel:+27749685168",
  },
];

/* `hidden` is stripped rather than passed through — TicketCard has no such
   prop, and it would land on the element as the HTML attribute of that name.
   The left/right stagger indexes the visible stack, so it stays alternating. */
const visibleTickets = tickets.filter((ticket) => !ticket.hidden).map(({ hidden, ...ticket }) => ticket);
---

<Section id="kaartjies" bg="none">
  {/* Figma positions this 1109px-wide swirl at x=1206 in a 1920px-wide
     frame, so its right edge sits ~20.6% past the section's own edge —
     Section's overflow-hidden clips it there, same as in the design. */}
  <img
    src={bgVector.src} alt="" aria-hidden="true"
    class="pointer-events-none absolute right-[-20.6%] top-[5.7%] w-[57.78%] max-w-none landscape:hidden"
  />

  <Container class="relative flex flex-col items-center gap-24 landscape:gap-12">
    <div class="flex flex-col items-center gap-6 text-center">
      <h2 class="h1" data-split>Kersiefees-Toegang</h2>
      <p class="body-lg max-w-4xl">
        Jou kaartjie na 'n dag vol kersiepret! Kom vier die Ceres Kersiefees saam met ons op Saterdag, 5 Desember 2026. Geniet heerlike kos, vars kersies,
        musiek, vermaak en hope familiepret — alles op een plek. Kry jou kaartjies vroegtydig en maak seker jy mis nie dié somerfees nie.
      </p>
    </div>

    <div class="flex w-full flex-col gap-8 landscape:gap-6">
      {visibleTickets.map((ticket, i) => (
        <div class:list={["flex", i % 2 === 0 ? "justify-end" : "justify-start"]}>
          <TicketCard {...ticket} class="w-3/4 landscape:w-full" />
        </div>
      ))}
    </div>
  </Container>
</Section>
