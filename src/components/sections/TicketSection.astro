---
import type { ComponentProps } from "astro/types";
import Container from "../ui/Container.astro";
import Section from "../ui/Section.astro";
import TicketCard from "../ui/TicketCard.astro";

import bgVector from "../../assets/figma/ticket-bg-vector.svg";
import kinderkaartjiePhoto from "../../assets/figma/ticket-photo-kinderkaartjie.png";
import opelugPreekPhoto from "../../assets/figma/ticket-photo-opelug-preek.jpg";
import standaardkaartjiePhoto from "../../assets/figma/ticket-photo-standaardkaartjie.jpg";

/* Three tickets, spaced out (not overlapping) and alternating left/right +
   a slight counter-clockwise tilt, as in the Figma frame. */
const tickets: ComponentProps<typeof TicketCard>[] = [
  {
    title: "Standaardkaartjie",
    lines: ["Saterdag, 5 Desember 2026"],
    prices: [{ price: "R250" }],
    variant: "white",
    rotate: -2,
    image: { src: standaardkaartjiePhoto.src, alt: "Feesganger geniet 'n verkoelende kersiedrankie" },
  },
  {
    title: "Kinderkaartjie",
    lines: ["(5-18 ouderdom)"],
    prices: [{ price: "R150" }],
    variant: "red",
    rotate: -0.36,
    /* Figma's second card-layout variant: the image is a transparent
       cutout that bleeds to the card's top/bottom edges instead of
       sitting inset like the other two cards. */
    flush: true,
    image: { src: kinderkaartjiePhoto.src, alt: "Riaan Benadé en Bok van Blerk tree op by die Kersiefees" },
  },
  {
    title: "Opelug Preek",
    lines: [
      "Sondag, 6 Desember 2026",
      "Kerke, bedieninge en gelowiges van Ceres en omgewing word uitgenooi om saam te kom vir 'n spesiale oggend van lofprysing en aanbidding ter ere van Jesus.",
    ],
    prices: [{ price: "Gratis" }],
    cta: "Leer meer",
    variant: "white",
    rotate: -2,
    image: { src: opelugPreekPhoto.src, alt: "Feesgangers aanbid saam terwyl die son sak" },
  },
];
---

<Section id="kaartjies" bg="none">
  {/* Figma positions this 1109px-wide swirl at x=1206 in a 1920px-wide
     frame, so its right edge sits ~20.6% past the section's own edge —
     Section's overflow-hidden clips it there, same as in the design. */}
  <img
    src={bgVector.src} alt="" aria-hidden="true"
    class="pointer-events-none absolute right-[-20.6%] top-[5.7%] w-[57.78%] max-w-none landscape:hidden"
  />

  <Container class="relative flex flex-col items-center gap-24 landscape:gap-12">
    <div class="flex flex-col items-center gap-6 text-center">
      <h2 class="h1" data-split>Kersiefees-Toegang</h2>
      <p class="body-lg max-w-4xl">
        Jou kaartjie na 'n dag vol kersiepret! Kom vier die Ceres Kersiefees saam met ons op Saterdag, 5 Desember 2026. Geniet heerlike kos, vars kersies,
        musiek, vermaak en hope familiepret — alles op een plek. Kry jou kaartjies vroegtydig en maak seker jy mis nie dié somerfees nie.
      </p>
    </div>

    <div class="flex w-full flex-col gap-8 landscape:gap-6">
      {tickets.map((ticket, i) => (
        <div class:list={["flex", i % 2 === 0 ? "justify-start" : "justify-end"]}>
          <TicketCard {...ticket} class="w-3/4 landscape:w-full" />
        </div>
      ))}
    </div>
  </Container>
</Section>
