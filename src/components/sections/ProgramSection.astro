---
/**
 * "Maak dit 'n naweek om te onthou!" — the festival-programme section
 * (Figma node 817:5335, instanced on the page as "Vendors Section" even
 * though its underlying component is "Program Section" and its content is
 * the Saturday schedule). Kept as its own section so page order matches the
 * Figma frame exactly.
 */
import VendorSlideshow from "../interactive/VendorSlideshow.tsx";
import CloudOverlap from "../ui/CloudOverlap.astro";
import Container from "../ui/Container.astro";
import Section from "../ui/Section.astro";

import program_01 from "../../assets/images/program-section/01.avif";
import program_02 from "../../assets/images/program-section/02.avif";
import program_03 from "../../assets/images/program-section/03.avif";
import program_04 from "../../assets/images/program-section/04.avif";
import program_05 from "../../assets/images/program-section/05.avif";
import program_06 from "../../assets/images/program-section/06.avif";
import program_07 from "../../assets/images/program-section/07.avif";
import program_08 from "../../assets/images/program-section/08.avif";

const photos = [
  { src: program_01.src, alt: "" },
  { src: program_02.src, alt: "" },
  { src: program_03.src, alt: "" },
  { src: program_04.src, alt: "" },
  { src: program_05.src, alt: "" },
  { src: program_06.src, alt: "" },
  { src: program_07.src, alt: "" },
  { src: program_08.src, alt: "" },
];

const schedule = [
  "16:00 – Kersie-geïnspireerde Mark & Mixologie-kroeg",
  "16:00 – 20:00 – Mini Kersie-Jol Area",
  "16:00 – 22:00 – Musiek & Vermaak",
  "18:00 – Riaan Benadé",
  "20:30 – Bok van Blerk",
];
---

<Section id="program" bg="cherry" class="pb-32 landscape:pb-24" data-cloud-parallax>
  <Container class="relative z-10 grid grid-cols-[minmax(0,35rem)_minmax(0,1fr)] gap-16 tablet:grid-cols-1 items-center">
    <div class="grid min-h-131 tablet:min-h-105 portrait:min-h-80">
      <VendorSlideshow photos={photos} client:visible />
    </div>
    <div class="text-white">
      <h2 class="h1" data-split>Maak dit 'n naweek om te onthou!</h2>
      <p class="h3 font-bold mt-8">Feesprogram</p>
      <div class="body-lg mt-4 flex flex-col">
        {schedule.map((line) => <p>{line}</p>)}
      </div>
      <p class="body-lg font-bold mt-4">Hekke sluit om 20:00</p>
    </div>
  </Container>

  <CloudOverlap class="text-blossom" />
</Section>
