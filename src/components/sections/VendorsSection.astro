---
import VendorSlideshow from "../interactive/VendorSlideshow.tsx";
import Button from "../ui/Button.astro";
import Container from "../ui/Container.astro";
import Section from "../ui/Section.astro";

import vender_01 from "../../assets/images/vendor-section/01.png";
import vender_02 from "../../assets/images/vendor-section/02.png";
import vender_03 from "../../assets/images/vendor-section/03.png";
import vender_04 from "../../assets/images/vendor-section/04.png";
import vender_05 from "../../assets/images/vendor-section/05.png";
import vender_06 from "../../assets/images/vendor-section/06.png";
import vender_07 from "../../assets/images/vendor-section/07.png";
import vender_08 from "../../assets/images/vendor-section/08.png";


/* Figma places one photo here (the pizza); the other two are the vendor
   shots already in the repo. The two About photos this used to borrow are
   gone — they belong to the welcome carousel, and one of them was captioned
   as a food stall when it is a cherry-picking shot. */
const photos = [
  { src: vender_01.src, alt: "" },
  { src: vender_02.src, alt: "" },
  { src: vender_03.src, alt: "" },
  { src: vender_04.src, alt: "" },
  { src: vender_05.src, alt: "" },
  { src: vender_06.src, alt: "" },
  { src: vender_07.src, alt: "" },
  { src: vender_08.src, alt: "" },
];
---

<Section id="verkopers" bg="none">
  <Container class="grid grid-cols-[minmax(0,35rem)_minmax(0,1fr)] gap-16 tablet:grid-cols-1 items-center">
    <div class="grid min-h-131 tablet:min-h-105 portrait:min-h-80">
      <VendorSlideshow photos={photos} client:visible />
    </div>
    <div>
      <h2 class="h1" data-split>Kersie-Geïnspireerde Verkopers</h2>
      <p class="body-lg mt-8">
        By die Ceres Kersiefees gaan ons stalletjies hul geregte 'n unieke kersie-twist gee! Ons nooi hulle uit om kreatief te raak en gewone gunstelinge te
        omskep in iets besonders – met Ceres-kersies as die ster van die gereg. Van soet tot sout, van souse tot nageregte en drankies – verwag verrassende
        kersiekombinasies wat jy net by die fees kan kom proe. Kom ontdek hoe lekker 'n kersie kan wees wanneer dit 'n bietjie anders opgedis word!
      </p>
      <p class="h3 font-bold mt-6">Wil jy 'n verkoper wees?</p>
      <p class="body-lg mt-6">
        Ons op soek na uitstaande kersie-geinspireerde kos, drankies, gebak en lekkergoed wat saam met ons 'n onvergeetlike feeservaring kan skep.
      </p>
      <Button href="https://cdn.prod.website-files.com/6a7d878721e690252d56a2d1/6a85686c6eeac9033835794e_Y26_Kersiefees_Vendors-Info_v02_an.pdf" class="mt-8">Doen Aansoek om 'n Verkoper te Wees</Button>
    </div>
  </Container>
</Section>
