---
import VendorSlideshow from "../interactive/VendorSlideshow.tsx";
import Button from "../ui/Button.astro";
import Container from "../ui/Container.astro";
import Section from "../ui/Section.astro";

import crowd2 from "../../assets/figma/about-photo-crowd-2.jpg";
import crowd from "../../assets/figma/about-photo-crowd.jpg";
import vendors2 from "../../assets/figma/vendors-2.jpg";
import vendors3 from "../../assets/figma/vendors-3.jpg";
import pizza from "../../assets/figma/vendors-pizza.jpg";

const photos = [
  { src: pizza.src, alt: "Kersie-geïnspireerde pizza by 'n verkoperstalletjie" },
  { src: vendors3.src, alt: "Besoekers gesels by die verkoperstalletjies" },
  { src: vendors2.src, alt: "Kersie-geïnspireerde produkte by die mark" },
  { src: crowd.src, alt: "Feesgangers by die kosstalletjies" },
  { src: crowd2.src, alt: "Verkopers by die Krummel & Vlokkie stalletjie" },
];
---

<Section id="verkopers" bg="none">
  <Container class="grid grid-cols-[minmax(0,35rem)_minmax(0,1fr)] gap-16 tablet:grid-cols-1 items-center">
    <div class="grid min-h-131 tablet:min-h-105 portrait:min-h-80">
      <VendorSlideshow photos={photos} client:visible />
    </div>
    <div>
      <h2 class="h1" data-split>Kersie-Geïnspireerde Verkopers</h2>
      <p class="body-lg mt-8">
        By die Ceres Kersiefees gaan ons stalletjies hul geregte 'n unieke kersie-twist gee! Ons nooi hulle uit om kreatief te raak en gewone gunstelinge te
        omskep in iets besonders – met Ceres-kersies as die ster van die gereg. Van soet tot sout, van souse tot nageregte en drankies – verwag verrassende
        kersiekombinasies wat jy net by die fees kan kom proe. Kom ontdek hoe lekker 'n kersie kan wees wanneer dit 'n bietjie anders opgedis word!
      </p>
      <p class="h3 font-bold mt-6">Wil jy 'n verkoper wees?</p>
      <p class="body-lg mt-6">
        Ons op soek na uitstaande kersie-geinspireerde kos, drankies, gebak en lekkergoed wat saam met ons 'n onvergeetlike feeservaring kan skep.
      </p>
      <Button href="#kontak" class="mt-8">Doen Aansoek om 'n Verkoper te Wees</Button>
    </div>
  </Container>
</Section>
