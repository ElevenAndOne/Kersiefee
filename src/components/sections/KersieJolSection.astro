---
/**
 * "Kersie-Jol Area" — the kids' play zone (Figma node 817:5469, instanced on
 * the page as a second "About Section" even though its content is entirely
 * about the children's activity area). Kept as its own section so page order
 * matches the Figma frame exactly.
 */
import Container from "../ui/Container.astro";
import Section from "../ui/Section.astro";

import cherry_01 from "../../assets/images/cherry-section/01.avif";
import cherry_02 from "../../assets/images/cherry-section/02.avif";
import cherry_03 from "../../assets/images/cherry-section/03.avif";
import cherry_04 from "../../assets/images/cherry-section/04.avif";
import cherry_05 from "../../assets/images/cherry-section/05.avif";

const activities = ["Mini-hindernisbaan", "Ballonkuns", "Gesigverf", "Smullekkernye", "Inkleurstasie", "Haarvleg (Colourful Braids)"];

const photos = [
  { src: cherry_01.src, alt: "" },
  { src: cherry_02.src, alt: "" },
  { src: cherry_03.src, alt: "" },
  { src: cherry_04.src, alt: "" },
  { src: cherry_05.src, alt: "" },
];
---

<Section id="kersie-jol" bg="none">
  <Container class="flex flex-col items-center gap-24">
    <div class="flex flex-col items-center gap-6 text-center">
      <h2 class="h1" data-split>Kersie-Jol Area</h2>
      <p class="body-lg max-w-4xl">
        'n Speelparadys vir die klein kersies! Die Kersie-Jol Area is propvol pret vir die jongspan — van springkastele, trekkerritte en 'n mini-hindernisbaan
        tot gesigverf, ballonkuns, slime, inkleur en nog baie meer. Laat die kinders speel, ontdek en jol terwyl die grootmense die fees geniet. Bring jou klein
        kersies — ons sien julle daar!
      </p>
    </div>

    <div class="flex flex-col items-center w-full" data-marquee data-marquee-speed="35">
      <div class="w-screen">
        <div class="marquee-track gap-10 pr-10">
          {[0, 1].map((copy) => (
            <div class="flex shrink-0 items-center gap-10" aria-hidden={copy === 1 ? "true" : undefined}>
              {activities.map((item) => <span class="h2 whitespace-nowrap">{item}</span>)}
            </div>
          ))}
        </div>
      </div>
    </div>

    <div class="flex flex-col items-center w-full" data-marquee data-marquee-speed="35">
      <div class="w-screen">
        <div class="marquee-track gap-10 pr-10">
          {[0, 1].map((copy) => (
            <div class="flex shrink-0 items-center gap-10" aria-hidden={copy === 1 ? "true" : undefined}>
              {photos.map((photo) => (
                <img
                  src={photo.src} alt={photo.alt} class="aspect-square w-80 rounded-blob object-cover" loading="lazy"
                  data-rise
                />
              ))}
            </div>
          ))}
        </div>
      </div>
    </div>
  </Container>
</Section>
