---
import FaqAccordion from "../interactive/FaqAccordion.tsx";
import Button from "../ui/Button.astro";
import Container from "../ui/Container.astro";
import Section from "../ui/Section.astro";

import chevron from "../../assets/figma/faq-chevron.svg";

import postCherryBranch from "../../assets/figma/social-post-cherry-branch.avif";
import postFeesvier from "../../assets/figma/social-post-feesvier.avif";
import postRiaan from "../../assets/figma/social-post-riaan.avif";
import postSmulkunstenaar from "../../assets/figma/social-post-smulkunstenaar.avif";
import postTicket from "../../assets/figma/social-post-ticket.avif";

/* Capitalised for display, lower-cased in the URL to match the dev note. */
const HANDLE = "Ceres_Kersiefees";
const PROFILE = `https://www.instagram.com/${HANDLE.toLowerCase()}/`;

/* `href` deep-links a single post; without one the tile falls back to the
   profile, which is where the "Sien meer" button goes too. */
const posts: { src: string; alt: string; href?: string; }[] = [
  { src: postFeesvier.src, alt: "Ons gaan feesvier! - aankondiging van die Kersiefees" },
  { src: postTicket.src, alt: "5 Desember by Victoria Park Rugbyklub" },
  { src: postRiaan.src, alt: "Sien vir Riaan Benadé by die Kersiefees" },
  { src: postSmulkunstenaar.src, alt: "Is jy 'n smulkunstenaar, lekkergoedmaker?" },
  { src: postCherryBranch.src, alt: "Kersietak-illustrasie" },
];

const items = [
  {
    question: "Hoe laat begin die geleentheid?",
    answer: "Sportgeleenthede begin om 06:00. Die hoof fees by die Rugbyklub open om 09:00. Die sonsondergang konsert begin om 18:00.",
  },
  {
    question: "Het ek 'n kaartjie nodig?",
    answer:
      "Fees toegang is gratis met sportgeleentheid registrasie, of R50 algemene toegang. Die sonsondergang konsert vereis 'n aparte kaartjie (R250 standaard, R500 VIP).",
  },
  {
    question: "Is dit gesinsvriendelik?",
    answer: "Absoluut! Ons het 'n toegewyde kinders sone met aktiwiteite heeldag. Familie kaartjies beskikbaar.",
  },
  {
    question: "Waar kan ek parkeer?",
    answer: "Gratis parkering by die Rugbyklub en aangewese nabygeleë areas.",
  },
  {
    question: "Kan ek my eie kos saambring?",
    answer: "Buite kos word toegelaat by die fees, maar ons moedig jou aan om ons kersie-geïnspireerde verkopers te ondersteun!",
  },
  {
    question: "Wat as dit reën?",
    answer: "Die geleentheid gaan voort reën of skyn. Sommige aktiwiteite is onder dak.",
  },
  {
    question: "Word honde toegelaat?",
    answer: "Goed-opgevoede honde aan leibande is welkom by die buite fees areas. Geen honde by die sonsondergang konsert nie.",
  },
];
---

<Section id="faq-section" bg="white">
  <Container class="flex flex-col gap-24">
    <h2 class="h1" data-split>Gereelde Vrae</h2>
    <FaqAccordion items={items} chevronIcon={chevron.src} client:visible />
    <Button href="mailto:runeik@dutoit.com">Meer vrae? Kontak ons</Button>

    {/* Trailing "@Ceres_Kersiefees" social block — sits inside the FAQ
        section itself in Figma (785:1618), not a separate section. */}
    <div class="flex items-start justify-between gap-8 landscape:flex-col">
      <div class="flex flex-col gap-5">
        <h3 class="h1">@{HANDLE}</h3>
        <p class="h3">Volg ons op sosiale media!</p>
      </div>
      <Button href={PROFILE} class="shrink-0">Sien meer</Button>
    </div>

    {/* Every tile clicks through to Instagram. The grid stacks to a single
        column on a phone, so by the time a post is on screen it reads as its
        own card — worth a tap rather than a scroll past. */}
    <div class="grid grid-cols-5 gap-6.5 tablet:grid-cols-3 landscape:grid-cols-2 portrait:grid-cols-1">
      {posts.map((post) => (
        <a href={post.href ?? PROFILE} class="group block aspect-303/394 overflow-hidden rounded-blob">
          <img src={post.src} alt={post.alt} class="size-full object-cover transition-transform duration-300 group-hover:scale-105" loading="lazy" />
        </a>
      ))}
    </div>
  </Container>
</Section>
