---
import Container from "../ui/Container.astro";
import Section from "../ui/Section.astro";

import ContactForm from "../interactive/ContactForm.tsx";
---

<Section id="contact-section" bg="pink">
  <Container class="min-h-screen">
    <div class="box-shadow relative flex flex-col items-center gap-6 px-16 py-12 landscape:px-12 portrait:px-6 bg-white">
      <h2 class="h1 w-full border-b border-blossom pb-6 text-center" data-split>Kontak Ons</h2>
      <ContactForm client:visible />
    </div>
  </Container>
</Section>
