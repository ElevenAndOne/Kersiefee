    /* Municipal resort with no online booking — Ceres Tourism carries the
       official phone and email details. */
    href: "https://www.ceres.org.za/places/pine-forest-holiday-resort/",
    cta: "Doen navraag",
  },
  {
    title: "Heiveld Farm Cottages",
