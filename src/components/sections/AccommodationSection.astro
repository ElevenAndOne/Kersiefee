/* The seven the client highlighted on the Koue Bokkeveld map ("Please also
   check that these are included"). Kaleo and Heiveld already run as featured
   cards above; the other five had no place on the page at all. Contact details
   come from the map itself, topped up from the workbook's OUT OF TOWN, CAMPING
   and VENUES sheets where those carry an address as well. */
const outOfTown: Listing[] = [
  { title: "Boplaas 1743 Gastehuis", type: "Gastehuis en selfsorg", tel: ["023 317 0040", "076 141 2720"], email: "info@boplaas1743.co.za" },
  { title: "Gys se Huis", type: "Selfsorg", tel: ["076 290 7115"], email: "forgottenhighwayceres@gmail.com" },
  { title: "Heiveld Farm Cottages", type: "Selfsorg en kampeer", tel: ["083 661 9912"], email: "johalet@houdenbek.co.za" },
  { title: "Kaleo Guest Farm", type: "Selfsorg en kampeer", tel: ["082 922 8967"], email: "stay@kaleomanor.co.za" },
  { title: "Ribbokskloof Cottages", type: "Selfsorg en kampeer", tel: ["079 523 7010"] },
  { title: "The Hamlet Country Lodge", type: "Lodge", tel: ["023 313 3070", "071 648 9439"] },
  { title: "Wadrif", type: "Selfsorg", tel: ["073 929 7871"] },
];

/* Nothing is listed twice on one page: anything already carrying a full card
   above drops out of the directory. Derived from the featured arrays rather
   than pruned by hand, so adding or pulling a card keeps this correct on its
   own — the titles are written to match. */
const featured = new Set([...guestHouses, ...campsites].map((stay) => stay.title));

const directories = [
  { title: "In die dorp", listings: inTown },
  { title: "Buite die dorp", listings: outOfTown },
].map((group) => ({ ...group, listings: group.listings.filter((listing) => !featured.has(listing.title)) }));
---

<Section id="akkommodasie" bg="none">
  {/* Figma's visible "Background" slot: one faint cherry squiggle, bled off
      the left edge, sized/positioned relative to the 1920px frame. */}
  <img
    src={bgVector.src} alt="" aria-hidden="true"
    class="pointer-events-none absolute left-[-32.29%] top-0 w-[79.31%] max-w-none landscape:hidden"
  />

  <Container class="relative flex flex-col items-center gap-16 landscape:gap-10">
    <div class="flex flex-col items-center gap-6 text-center">
      <h2 class="h1" data-split>Maak dit ‘n naweek!</h2>
      <p class="body-lg max-w-4xl">
        Ontdek die beste verblyf- en kampeeropsies in Ceres en die omliggende gebiede. Of jy nou op soek is na ‘n gerieflike gastehuis in die dorp, ‘n
        selfsorg-eenheid vir die gesin, of ‘n rustige kampeerplek tussen die berge en natuur, daar is ‘n opsie vir elke tipe reisiger en begroting.
      </p>
      <p class="body-lg max-w-4xl">
        Ons het die opsies beoordeel op grond van <strong class="font-bold">ligging, gerief, fasiliteite, kapasiteit en waarde vir geld,</strong> sodat jy
        maklik die regte plek vir jou besoek kan kies.
      </p>
    </div>

    {/* Figma's "Grid": two full-bleed tracks stacked with the same 20px gutter
        that separates the cards inside them. */}
    <div class="flex w-full flex-col gap-5">
      {rows.map((row) => (
        <div class="flex w-full flex-col items-center" data-stay-marquee data-marquee-speed="30" data-marquee-reverse={row.reverse || undefined}>
          <div class="w-screen">
            <div class="marquee-track items-start! gap-5 pr-5">
              {[0, 1].map((copy) => (
                <div class="flex shrink-0 items-start gap-5" aria-hidden={copy === 1 ? "true" : undefined}>
                  {row.stays.map((stay, index) => (
                    <article class="flex w-[clamp(17rem,28vw,32.4375rem)] shrink-0 flex-col gap-5 rounded-blob border-2 border-cherry p-8.75 portrait:p-6" data-rise>
                      {/* The number hangs in the margin, so a wrapped title
                          lines up under itself, not under the digits. */}
                      <h3 class="h2 flex gap-2.5">
                        <span class="shrink-0">{row.from + index}.</span>
                        <span>{stay.title}</span>
                      </h3>
                      <p class="body-lg font-bold leading-tight">
                        {stay.price.map((line, i) => (
                          <Fragment>{i > 0 && <br />}{line}</Fragment>
                        ))}
                      </p>
                      <p class="body-lg leading-snug">{stay.body}</p>
                      {/* Nine near-identical CTAs, so each one names its own
                          listing for screen readers. */}
                      <Button
                        href={stay.href}
                        target={stay.href ? "_blank" : undefined}
                        variant="white"
                        class="self-start"
                      >
                        {stay.cta ?? "Kontak"}
                        <span class="sr-only">&nbsp;— {stay.title}</span>
                      </Button>
                    </article>
                  ))}
                </div>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>

    {/* Ceres Toerisme's full list. Deliberately plainer than the featured
        cards above — name, type and contact details only — so it reads as a
        directory to scan rather than nine more things to compare. */}
    <div class="flex w-full flex-col items-center gap-10">
      <div class="flex max-w-4xl flex-col items-center gap-4 text-center">
        <h3 class="h1" data-split>Nog plekke om te bly</h3>
        <p class="body-lg">
          Die volledige verblyflys vir Ceres en die omgewing, met dank aan Ceres Toerisme. Skakel of e-pos die eienaars direk vir beskikbaarheid en pryse.
        </p>
        <p class="body-lg">
          Ceres Toerismekantoor: <a href="tel:+27233161287" class="font-bold underline underline-offset-4 hover:no-underline">023 316 1287</a>
          {" · "}
          <a href="https://www.ceres.org.za" target="_blank" rel="noopener noreferrer" class="font-bold underline underline-offset-4 hover:no-underline">
            ceres.org.za
          </a>
        </p>
      </div>

      {directories.map((group) => (
        <div class="flex w-full flex-col gap-6">
          <h4 class="h2 text-center">{group.title}</h4>
          <ul class="grid grid-cols-3 gap-5 tablet:grid-cols-2 landscape:grid-cols-1">
            {group.listings.map((listing) => (
              <li class="flex flex-col gap-2 rounded-blob bg-white p-6 shadow-cherry-soft" data-rise>
                <h5 class="h3 font-extrabold leading-tight">{listing.title}</h5>
                <p class="text-body font-bold opacity-70">{listing.type}</p>
                {/* Links, not plain text — on a phone these are the whole
                    point of the listing. */}
                <div class="flex flex-col items-start gap-1 text-body">
                  {listing.tel.map((tel) => (
                    <a href={telHref(tel)} class="underline underline-offset-4 hover:no-underline">
                      {tel}
                      <span class="sr-only">&nbsp;— {listing.title}</span>
                    </a>
                  ))}
                  {listing.email && (
                    <a href={`mailto:${listing.email}`} class="break-words underline underline-offset-4 hover:no-underline">
                      {listing.email}
                    </a>
                  )}
                </div>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </Container>
</Section>

<script>
  import { gsap } from "gsap";
  import { dragScrub } from "../../scripts/marquee";
  import { reducedMotion, registerEases } from "../../scripts/motion";

  registerEases();

  /* Same full-bleed marquee mechanic as the About/Sponsors/Kersie-Jol tickers,
     but on its own data attribute rather than `data-marquee` for two reasons:
     these rows need a per-row direction, and — like the Sport carousel — cards
     with a CTA in them need a genuine stop on hover, not the shared helper's
     ease down to 15%. */
  document.querySelectorAll<HTMLElement>("[data-stay-marquee]").forEach((wrap) => {
    const track = wrap.querySelector<HTMLElement>(".marquee-track");
    if (!track) return;

    if (reducedMotion()) {
      /* No auto-scroll: drop the aria-hidden duplicate group (it only exists
         to make the loop seamless) and let the row become a plain
         manually-scrollable strip instead. */
      track.parentElement?.classList.add("overflow-x-auto");
      track.querySelectorAll<HTMLElement>(':scope > [aria-hidden="true"]').forEach((el) => el.remove());
      return;
    }

    /* The duplicate group stays aria-hidden for screen readers but must remain
       hoverable and clickable — it's half of what's on screen at any moment.
       Only its sequential Tab order is worth trimming, so keyboard users don't
       get every listing's CTA twice. */
    track.querySelectorAll<HTMLElement>(':scope > [aria-hidden="true"] a, :scope > [aria-hidden="true"] button').forEach((el) => {
      el.tabIndex = -1;
    });

    const speed = Number(wrap.dataset.marqueeSpeed ?? 30); // px / second
    /* One loop period: the offset between the two identical copies. NOT
       scrollWidth / 2 — once the track overflows, Chrome leaves its trailing
       padding-right out of scrollWidth, which put the wrap point half that
       padding short of a full period: a small jump every loop. */
    const copies = track.querySelectorAll<HTMLElement>(":scope > *");
    const distance = copies[1].offsetLeft - copies[0].offsetLeft;
    /* A reversed row starts one copy to the left and travels back to zero, so
       it reads rightward while the row above it reads leftward. Either way the
       two identical copies make the wrap-around invisible. */
    const reverse = wrap.dataset.marqueeReverse !== undefined;
    const tween = gsap.fromTo(
      track,
      { x: reverse ? -distance : 0 },
      { x: reverse ? 0 : -distance, duration: distance / speed, ease: "none", repeat: -1 },
    );

    /* Inertial hover: ramps timeScale all the way to 0 so the row genuinely
       comes to rest, then eases back up from wherever it stopped — no snap, no
       restart, it just keeps reading where it left off. */
    const rampTo = (scale: number, duration: number, ease: string) => gsap.to(tween, { timeScale: scale, duration, ease, overwrite: true });

    const slowToStop = () => rampTo(0, 0.7, "power2.out");
    const speedBackUp = () => rampTo(1, 0.9, "power1.inOut");

    /* Tracked so releasing a drag while still hovering leaves the row at rest,
       rather than overriding the hover stop. */
    let hovering = false;
    wrap.addEventListener("mouseenter", () => {
      hovering = true;
      slowToStop();
    });
    wrap.addEventListener("mouseleave", () => {
      hovering = false;
      speedBackUp();
    });

    /* Drag to scrub. `span` carries the row's direction, so the reversed
       bottom row follows the pointer the same way the top one does. */
    dragScrub(wrap, tween, {
      span: reverse ? distance : -distance,
      onGrab: () => gsap.killTweensOf(tween),
      onRelease: () => {
        if (!hovering) speedBackUp();
      },
    });

    // Keyboard focus pauses it the same way — a moving target is nearly
    // impossible to use without a mouse.
    wrap.addEventListener("focusin", slowToStop);
    wrap.addEventListener("focusout", (event) => {
      const next = (event as FocusEvent).relatedTarget as Node | null;
      if (!next || !wrap.contains(next)) speedBackUp();
    });
  });
</script>
