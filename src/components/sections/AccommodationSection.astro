  { title: "Mountain View Guest House", type: "Bed & ontbyt", tel: ["082 497 2672"], email: "info@mountainviewceres.co.za" },
  { title: "Pine Forest Holiday Resort", type: "Selfsorg en kampeer", tel: ["023 492 0183", "023 492 0184"], email: "denontvangs1@witzenberg.gov.za" },
  { title: "Porterhouse Eleven Guest House", type: "Selfsorg en bed & ontbyt", tel: ["023 312 1278"], email: "bookings@porterhouseceres.co.za" },
  { title: "Riverside Lodge", type: "Bed & ontbyt", tel: ["023 316 1653", "072 101 4519"], email: "riverside.ceres1@gmail.com" },
  { title: "The Village Guest House & Restaurant", type: "Bed & ontbyt", tel: ["023 316 2035", "082 448 9092"], email: "bookings@thevillageceres.co.za" },
  { title: "Time & Again Accommodation", type: "Selfsorg", tel: ["082 375 7157"], email: "time.again3757@gmail.com" },
  { title: "Vrede & Vreugde Accommodation", type: "Selfsorg", tel: ["082 890 0146"], email: "benmarphithi@mweb.co.za" },
