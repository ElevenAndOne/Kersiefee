/* Guest houses drift left, the farms and campsites drift back right. `from`
   continues the numbering across the two rows. */
const rows = [
  { stays: guestHouses, from: 1, reverse: false },
  { stays: campsites, from: guestHouses.length + 1, reverse: true },
];

/* ---------------------------------------------------------------------------
   Ceres Toerisme se eie verblyflys.

   Added at the client's request (Runei Kotze, via ClickUp): "can we please add
   the IN TOWN accommodation to our Kersiefees list? It doesn't need to have
   prices and all the details. Minimum info is fine. Contact details & name."

   So these are contact tiles, not booking cards — no prices, no write-up, no
   CTA — and they sit in a static grid rather than joining the marquees above.
   Source: the "2026 Ceres Accommodation and Services List" workbook, IN TOWN
   sheet.
--------------------------------------------------------------------------- */
interface Listing {
  title: string;
  /** Accommodation type, from the tourism list. */
  type: string;
  /** One entry per published number; each becomes its own tel: link. */
  tel: string[];
  email?: string;
}

/** `tel:` target — strip the spacing and swap the leading 0 for +27. */
const telHref = (tel: string) => `tel:${tel.replace(/\D/g, "").replace(/^0/, "+27")}`;

const inTown: Listing[] = [
  { title: "Apple & Pear Accommodation", type: "Selfsorg", tel: ["063 913 9489"], email: "appleandpearaccommodation@gmail.com" },
  { title: "Chantilly Guest House", type: "Selfsorg en bed & ontbyt", tel: ["083 441 9532"], email: "tanyafre00@gmail.com" },
  { title: "Cherry Blossom Cottage", type: "Selfsorg", tel: ["082 763 5961"], email: "hello@cherryblossomcottage.co.za" },
  { title: "Four Seasons", type: "Selfsorg", tel: ["023 316 2035"], email: "bookings@thevillageceres.co.za" },
