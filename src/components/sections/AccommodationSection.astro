---
import Button from "../ui/Button.astro";
import Container from "../ui/Container.astro";
import Section from "../ui/Section.astro";

import bgVector from "../../assets/figma/accommodation-bg-vector.svg";

/* Verblyfopsies. Figma lays the listings out as two horizontal tracks, each
   wider than its row and clipped left/right — the raw "Track/List spills past
   its frame" shape the file also uses for the About/Sponsors/Kersie-Jol
   tickers. Here it really is a scroller: the two rows travel in opposite
   directions, the top one left, the bottom one right.

   The dev-handover frame numbers its cards 1-4 and 7-11 — 5 and 6 never got
   written — so the numbering is derived from the array position instead of
   being typed in, and closes up on its own once those two land.

   Still awaiting copy (the booking research covers all three): guest houses
   "Four Seasons" and "La Dolce Vita B&B" are the missing 5 and 6, and the
   campsite list is one short of the intended six — "Cederberg Conservancy –
   Nuwerust Rest Camp". */
interface Stay {
  title: string;
  /** Bold pricing block; one entry per line (a few of these run to three). */
  price: string[];
  body: string;
  /** Booking destination — always off-site, so the CTA opens in a new tab. */
  href?: string;
  /** CTA label. "Bespreek nou" only where `href` reaches a real availability/
      booking flow; "Doen navraag" where the best we have is an enquiry form or
      the property's contact details. */
  cta?: "Bespreek nou" | "Doen navraag";
}

const guestHouses: Stay[] = [
  {
    title: "The Village Guest House & Restaurant",
    price: ["Vanaf R680 per nag vir een persoon en R980 per nag vir twee persone wat deel."],
    body:
      "Dit is die beste veelsydige opsie in die dorp. Die gastehuis is sentraal geleë en bied verskillende kamertipes, gesinskamers, veilige parkering, Wi-Fi, ’n swembad en ’n gelisensieerde restaurant op die perseel. Daar is ook ’n kamer wat vir gaste met beperkte mobiliteit ingerig is.",
    href: "https://thevillageceres.co.za/bookings/",
    cta: "Doen navraag",
  },
  {
    title: "Porterhouse Eleven Guest House",
    price: ["Vanaf R1 000 per kamer per nag vir een persoon of R1 200 vir twee persone wat deel. Ontbyt kos R100 per persoon."],
    body:
      "’n Netjiese driester-gastehuis met agt ruim en suite-kamers, asook selfsorg- en gesinsopsies. Fasiliteite sluit lugversorging, Wi-Fi, veilige parkering, braaigeriewe en ’n klein plonspoel",
    href: "https://www.booking.com/hotel/za/porterhouse-eleven.html",
    cta: "Bespreek nou",
  },
  {
    title: "Cherry Blossom Cottage",
    price: ["Vanaf R2 000 vir een persoon of R2 700 vir twee persone. Tot vier persone kan vir R3 400 tuisgaan."],
    body:
      "’n Uitstekende opsie vir gesinne of klein groepe. Die tweeslaapkamerkothuis het en suite-badkamers, ’n volledig toegeruste kombuis, binnenshuise braai, kaggel, lugversorging, Wi-Fi en batterykrag tydens beurtkrag.",
    href: "https://www.booking.com/hotel/za/cherry-blossom-cottage-ceres.html",
    cta: "Bespreek nou",
  },
  {
    title: "Mountain View Guest House",
    price: ["R1 050 per nag vir een persoon of R1 500 vir twee persone wat deel. ’n Volledige Engelse ontbyt is ingesluit."],
