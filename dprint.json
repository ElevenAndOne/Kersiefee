{
  "lineWidth": 160,
  "indentWidth": 2,
  "markup": {
    "printWidth": 160,
    "maxAttrsPerLine": 4,
    "closingBracketSameLine": true,
    "singleAttrSameLine": true,
    "formatComments": false
  },
  "typescript": {
    "lineWidth": 160,
    "quoteStyle": "alwaysDouble",
    "semiColons": "always"
  },
  "json": {},
  "malva": {
    "printWidth": 100
  },
  "excludes": [
    "**/node_modules",
    "dist/**",
    ".astro/**",
    "package-lock.json"
  ],
  "plugins": [
    "https://plugins.dprint.dev/g-plane/markup_fmt-v0.27.3.wasm",
    "https://plugins.dprint.dev/typescript-0.96.1.wasm",
    "https://plugins.dprint.dev/json-0.23.0.wasm",
    "https://plugins.dprint.dev/g-plane/malva-v0.16.0.wasm"
  ]
}
